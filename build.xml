<project xmlns:if="ant:if">

    <property environment="env"/>

    <condition property="build.debug" value="true" else="false">
        <isset property="env.DEBUG"/>
    </condition>

    <target name="clean">
	<delete includeemptydirs="true">
		<fileset dir="build" erroronmissingdir="false">
			<!-- <exclude name=".gitignore"/> -->
		</fileset>
	</delete>
        <delete dir="dist"/>
    </target>

    <property name="java.lib" value="/usr/share/java"/>
    <path id="main.classpath">
      <fileset dir="${java.lib}">
        <include name="javassist.jar"/>
        <include name="jna.jar"/>
        <include name="jna-platform.jar"/>
      </fileset>
    </path>

    <target name="compile">
        <mkdir dir="build"/>
        <javac srcdir="src" destdir="build" classpathref="main.classpath" includeantruntime="false" debug="${build.debug}"/>
        <!-- <copy todir="build"> <fileset dir="." includes="img/**"/> </copy> -->
    </target>

    <target name="build" depends="compile">
        <mkdir dir="dist"/>
        <jar destfile="dist/flashalizer.jar" basedir="build" manifest="MANIFEST.MF">
            <zipfileset dir="img" prefix="img"/>
        </jar>
    </target>

    <target name="run">
        <condition property="run.extra.jvm.args" value="${env.APP_EXTRA}" else="">
            <isset property="env.APP_EXTRA"/>
        </condition>
        <condition property="run.jna.jvm.arg" value="-Djna.library.path=${env.ACTIONSWF_LIB}" else="">
            <isset property="env.ACTIONSWF_LIB"/>
        </condition>
        <condition property="run.jdwp.jvm.arg" value="-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=5005" else="">
            <isset property="env.JDWP"/>
        </condition>
        <condition property="run.app.args" value="${env.APP_ARGS}" else="">
            <isset property="env.APP_ARGS"/>
        </condition>
        <path id="run.classpath">
            <pathelement location="build"/>
            <pathelement location="."/>
            <path refid="main.classpath"/>
        </path>
        <pathconvert property="run.classpath.string" refid="run.classpath" pathsep=":"/>
        <echo message="Running: ${java.home}/bin/java --add-opens=java.base/java.lang=ALL-UNNAMED ${run.extra.jvm.args} ${run.jna.jvm.arg} ${run.jdwp.jvm.arg} -cp ${run.classpath.string} flashalizer ${run.app.args}"/>
        <java classname="flashalizer" fork="true" dir="${user.dir}">
            <arg line="${env.APP_ARGS}" if:set="env.APP_ARGS"/>

            <classpath refid="run.classpath"/>

            <jvmarg value="--add-opens=java.base/java.lang=ALL-UNNAMED"/>
            <jvmarg line="${env.APP_EXTRA}" if:set="env.APP_EXTRA"/>
            <!-- optional: local libactionswf build instead of the global one -->
            <jvmarg if:set="env.ACTIONSWF_LIB" value="-Djna.library.path=${env.ACTIONSWF_LIB}"/>

            <!-- optional: wait for jdb on port 5005 -->
            <jvmarg if:set="env.JDWP" value="-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=5005"/>

            <!-- optional: libactionswf built with ASan -->
            <env if:set="env.ACTIONSWF_ASAN" key="LD_PRELOAD" value="${env.ACTIONSWF_ASAN}"/>
            <env if:set="env.ACTIONSWF_ASAN" key="ASAN_OPTIONS" value="detect_leaks=0:handle_segv=0:handle_sigbus=0:handle_sigfpe=0:allow_user_segv_handler=1"/>
        </java>
    </target>

    <target name="run-dist" depends="build">
        <path id="run.dist.classpath">
            <pathelement location="dist/flashalizer.jar"/>
            <path refid="main.classpath"/>
        </path>
        <java classname="flashalizer" fork="true" dir="${user.dir}">
            <arg line="${env.APP_ARGS}" if:set="env.APP_ARGS"/>
            <classpath refid="run.dist.classpath"/>
            <jvmarg value="--add-opens=java.base/java.lang=ALL-UNNAMED"/>
            <jvmarg line="${env.APP_EXTRA}" if:set="env.APP_EXTRA"/>
            <jvmarg if:set="env.ACTIONSWF_LIB" value="-Djna.library.path=${env.ACTIONSWF_LIB}"/>
            <jvmarg if:set="env.JDWP" value="-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=5005"/>
            <env if:set="env.ACTIONSWF_ASAN" key="LD_PRELOAD" value="${env.ACTIONSWF_ASAN}"/>
            <env if:set="env.ACTIONSWF_ASAN" key="ASAN_OPTIONS" value="detect_leaks=0:handle_segv=0:handle_sigbus=0:handle_sigfpe=0:allow_user_segv_handler=1"/>
        </java>
    </target>

</project>
